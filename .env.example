# ==============================================================================
# Algions AI Labs Cinema Hall Ticket Booking System - Root Environment Guide
# ==============================================================================

# Backend (copy to backend/.env)
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cinema_booking?schema=public"
JWT_SECRET="your_secure_random_jwt_secret_here"
JWT_EXPIRES_IN="24h"
CORS_ORIGIN="http://localhost:5173"
COOKIE_SAME_SITE="lax"

# Frontend (copy to frontend/.env)
# Leave blank for local development proxy, set for cross-origin production deployment
VITE_API_URL=
